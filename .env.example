# =============================================================================
# VARIABLES DE ENTORNO — SERVIDOR DE IMPRESIÓN RASPBERRY PI 5
# Copie este archivo a .env y complete sus credenciales reales
# =============================================================================

# Credenciales de conexión SSH a Raspberry Pi 5
RPI_HOST=192.168.1.XXX
RPI_PORT=22
RPI_USER=tu_usuario
RPI_PASSWORD=tu_password_seguro

# Configuración de Cola CUPS
PRINTER_QUEUE_NAME=HP_LaserJet_M14_M17
PRINTER_DESCRIPTION="HP LaserJet Pro M14-M17 (USB RPi5)"
PRINTER_LOCATION="Red Local - Oficina"
CUPS_PORT=631

# Configuración de Red Local Windows / Samba
SAMBA_WORKGROUP=WORKGROUP
